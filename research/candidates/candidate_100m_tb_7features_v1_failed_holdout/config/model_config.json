{
  "features": [
    "return_3_bars_feature",
    "return_5_bars_feature",
    "vol_10_feature",
    "cvd_slope_feature",
    "aggressor_imbalance_feature",
    "hma_dist_feature",
    "wvf_zscore_feature"
  ],
  "model_type": "LightGBM (Shallow)",
